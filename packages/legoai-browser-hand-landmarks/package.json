{
  "name": "@legoai/browser-hand-landmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "static": "node tools/static-check.mjs",
    "test:compile": "tsc -p tsconfig.tests.json",
    "test:contracts": "node --test build/tests/contract.test.js build/tests/assets.test.js",
    "test:lifecycle": "node --test build/tests/lifecycle.test.js",
    "test:network": "node --test build/tests/network.test.js",
    "build": "node tools/build.mjs",
    "dev": "node tools/serve.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.21"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
