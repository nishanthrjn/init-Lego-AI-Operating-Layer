# ==============================================================================

# Lego AI Operating Layer

# Production-Grade Root .gitignore

#

# Principles:

# - Ignore generated, local, ephemeral, sensitive, machine-specific state.

# - DO NOT ignore source, specifications, ADRs, schemas, migrations, lockfiles,

# conformance definitions, evaluation definitions, or committed test fixtures.

# - Secrets must never be committed.

# - Runtime/evidence artifacts are ignored by default unless deliberately

# promoted into governed version-controlled fixtures.

# ==============================================================================

# ==============================================================================

# 1. Secrets, credentials, environment files

# ==============================================================================

.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.schema
!.env.defaults

*.env.local
*.secret
*.secrets
*.credential
*.credentials

secrets/
.secret/
.secrets/
credentials/
.credentials/

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.der

# SSH/private authentication material

id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# Cloud/provider credentials

.aws/
.azure/
.gcloud/
.kube/

# Local auth/token caches

.tokens/
.auth/
.auth-cache/
token-cache/
credential-cache/

# Never commit decrypted/local secret material

*.decrypted
*.plaintext-secret
*.secret.local

