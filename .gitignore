# ==============================================================================

# 56. Keep important repository files explicitly visible

#

# These negations protect common governance/reproducibility artifacts if broader

# rules are added later.

# ==============================================================================

!.gitignore
!.gitattributes
!.editorconfig

!README.md
!LICENSE
!SECURITY.md

!pyproject.toml

!uv.lock
!poetry.lock
!Pipfile.lock

!package-lock.json
!pnpm-lock.yaml
!yarn.lock
!bun.lock

!Cargo.lock

# Architecture / governance artifacts

!intent.md
!SPEC.md

!architecture/
!architecture/**

!contracts/
!contracts/**

!plugin-spec/
!plugin-spec/**

!security/
!security/**

!evaluation/
!evaluation/**

!conformance/
!conformance/**

!adrs/
!adrs/**

# Version-controlled migrations and schemas

!migrations/
!migrations/**

!schemas/
!schemas/**

# Tests should remain source controlled.

!tests/
!tests/**

# Keep generated test bytecode ignored after the test-source allowlist.
tests/**/__pycache__/
tests/**/*.py[cod]

# ==============================================================================

# 57. Final safety notes

#

# Do not add broad patterns such as:

#

# *.json

# *.yaml

# *.yml

# *.toml

# *.lock

# data/

# artifacts/

# evidence/

#

# Those may contain canonical contracts, fixtures, migrations, evaluation

# definitions, conformance cases, release evidence, or reproducibility metadata.

#

# Sensitive/generated subdirectories are ignored explicitly above instead.

# ==============================================================================
