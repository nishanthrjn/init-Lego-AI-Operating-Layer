    {
      "id": "q07",
      "class": "interface_impl",
      "question": "The in-memory cache should evict the least recently used entry instead of the oldest inserted one.",
      "files": {
        "cache/__init__.py": [
          "from cache.memory import MemoryCache",
          "",
          "",
          "def make_cache(size: int) -> MemoryCache:",
          "    return MemoryCache(size)"
        ],
        "cache/base.py": [
          "from abc import ABC, abstractmethod",
          "",
          "",
          "class Cache(ABC):",
          "    @abstractmethod",
          "    def get(self, key: str) -> object | None: ...",
          "",
          "    @abstractmethod",
          "    def put(self, key: str, value: object) -> None: ..."
        ],
        "cache/memory.py": [
          "from cache.base import Cache",
          "",
          "",
          "class MemoryCache(Cache):",
          "    def __init__(self, size: int) -> None:",
          "        self.size = size",
          "        self.items: dict[str, object] = {}",
          "",
          "    def get(self, key: str) -> object | None:",
          "        return self.items.get(key)",
          "",
          "    def put(self, key: str, value: object) -> None:",
          "        if len(self.items) >= self.size:",
          "            del self.items[next(iter(self.items))]",
          "        self.items[key] = value"
        ],
        "cache/redis_cache.py": [
          "from cache.base import Cache",
          "",
          "",
          "class RedisCache(Cache):",
          "    def __init__(self, client) -> None:",
          "        self.client = client",
          "",
          "    def get(self, key: str) -> object | None:",
          "        return self.client.get(key)",
          "",
          "    def put(self, key: str, value: object) -> None:",
          "        self.client.set(key, value)"
        ]
      },
      "oracle": {
        "expected": "succeeded",
        "required": ["cache/memory.py"],
        "acceptable": [["cache/memory.py"]],
        "context": ["cache/base.py"],
        "irrelevant": ["cache/__init__.py", "cache/redis_cache.py"]
      },
      "rationale": "1Q-ORACLE-NOTE only the memory implementation changes eviction."
    },
